{
  "date": "2026-10-16",
  "base_pr_commit": "5f90daa77af2de950e6e0228e5247a5d56b84ab2",
  "implementation": "Conservative native numeric cast batch kernels with released Flink evaluation for all other batches; no additional configuration",
  "environment": {
    "cpu": "Apple M4 Pro",
    "ram_gib": 24,
    "os": "macOS 26.5",
    "flink": "2.2.1",
    "jdk": 17,
    "rust_profile": "release",
    "allocator": "system",
    "parallelism": 1,
    "heap_gib": 8,
    "off_heap_accounting_budget_gib": 48,
    "off_heap_note": "Accounting budget shared by both engines, not resident memory or a reservation"
  },
  "boundary": "Complete bounded runtime Row source to rowwise blackhole, retaining both transposes and JNI, execution metrics and job completion; the optimized batches eliminate the scalar JVM upcall",
  "method": {
    "warmup_jobs_per_engine": 2,
    "measured_jobs_per_engine": 5,
    "order": "alternating each trial",
    "null_every": 7
  },
  "baselines": [
    "legacy-floating-decimal-trials-2026-10-16.json",
    "legacy-char-double-trials-2026-10-16.json"
  ],
  "limits": "Same-run stock ratios are primary. Previous implementation and previous-planner fallback samples are separate runs with their own stock controls. No speedup is claimed for batches requiring the JVM evaluator, other machines or persistent backends.",
